{
  "name": "partituras-api",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    // python depreciado:
    // "ghcr.io/devcontainers/features/python:1": {
    //   "version": "3.13",
    //   "installTools": false
    // }
  },

  "forwardPorts": [8080, 8000, 3306, 4200],

  "mounts": [
    "source=${devcontainerId}-partituras-site-node-modules,target=${containerWorkspaceFolder}/partituras-site/node_modules,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"],
      "settings": {
        "java.server.launchMode": "Standard"
      }
    }
  },

  "postCreateCommand": "/bin/bash .devcontainer/preparar-ambiente.sh",

  "postStartCommand": "service mysql start"
}
